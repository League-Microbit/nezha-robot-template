{
    "name": "nezha-robot-template",
    "version": "1.0.0",
    "description": "MakeCode project template for driving the Nezha robot with the DiffDrive extension. Start here to write JavaScript programs that move, turn, and navigate.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "nezha-diffdrive": "github:League-Robotics/pxt-nezha-diffdrive#v1.20261002.1",
        "pxt-PlanetX": "github:elecfreaks/pxt-PlanetX#v1.6.7",
        "microphone": "*",
        "settings": "*"
    },
    "files": [
        "README.md",
        "src/shapes.ts",
        "src/tours/tours.ts",
        "src/calibration/linetrack.ts",
        "src/calibration/calwheels.ts",
        "src/calibration/calturn.ts",
        "src/main.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit_radio_max_packet_size": 250,
            "device_ble": 0
        }
    },
    "disablesVariants": [
        "mbdal"
    ]
}
